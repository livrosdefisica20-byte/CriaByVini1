<!-- ESTILOS GLOBAIS -->
<style>
@import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=Outfit:wght@400;600;700;900&family=Space+Mono:wght@400;700&display=swap');

/* ─────────────────────────────────────────────────────────────────────────
   VARIÁVEIS DE TEMA - DESIGN ÚNICO CRIABYV INI
   ───────────────────────────────────────────────────────────────────────── */
:root {
  --bg-main:        #0a0e15;
  --bg-panel:       #0f1419;
  --bg-surface:     #141820;
  --bg-deep:        #070a10;
  --bg-hover:       #1a2432;
  --bg-active:      #1f3a52;
  --bg-inset:       rgba(0,0,0,0.4);
  --accent-cyan:    #3ddcff;
  --accent-pink:    #ff64c8;
  --accent-purple:  #d946ef;
  --accent-light:   #00d4ff;
  --accent-muted:   #0099cc;
  --accent-dim:     #004466;
  --text-primary:   #f0f4f8;
  --text-secondary: #a8b5c8;
  --text-muted:     #7a8899;
  --text-dim:       #5a6677;
  --border:         #1a3844;
  --border-accent:  #3ddcff;
  --border-subtle:  #141820;
  --alert:          #ff3366;
}

body {
  margin: 0;
  padding: 0;
  font-family: 'Outfit', sans-serif;
  color: var(--text-primary);
  overflow-x: hidden;
  background: radial-gradient(ellipse at 20% 50%, rgba(61,220,255,0.08) 0%, transparent 50%), 
              radial-gradient(ellipse at 80% 80%, rgba(255,100,200,0.06) 0%, transparent 50%),
              linear-gradient(180deg, #0a0e15 0%, #0f1419 50%, #0a0e15 100%);
  background-attachment: fixed;
  min-height: 100vh;
}

/* ─────────────────────────────────────────────────────────────────────────
   ANIMAÇÕES
   ───────────────────────────────────────────────────────────────────────── */
@keyframes shimmer {
  0%   { background-position: 0% 50%; }
  50%  { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}

@keyframes glow {
  0%, 100% { text-shadow: 0 0 8px rgba(61,220,255,0.3), 0 0 16px rgba(61,220,255,0.1); }
  50% { text-shadow: 0 0 12px rgba(61,220,255,0.5), 0 0 24px rgba(61,220,255,0.2); }
}

@keyframes fadeIn {
  from { opacity: 0; transform: scale(0.96) translateY(10px); }
  to   { opacity: 1; transform: scale(1) translateY(0); }
}

@keyframes slideIn {
  from { opacity: 0; transform: translateX(-20px); }
  to   { opacity: 1; transform: translateX(0); }
}

/* ─────────────────────────────────────────────────────────────────────────
   MODAL DE INTRODUÇÃO
   ───────────────────────────────────────────────────────────────────────── */
.intro-overlay {
  position: fixed;
  inset: 0;
  background: linear-gradient(135deg, rgba(10,14,21,0.95), rgba(15,20,25,0.98));
  backdrop-filter: blur(12px);
  display: none;
  justify-content: center;
  align-items: center;
  z-index: 99999;
}

.intro-window {
  width: 90%;
  max-width: 480px;
  background: linear-gradient(135deg, rgba(15,20,25,0.8), rgba(20,24,32,0.9));
  padding: 40px 36px;
  border: 2px solid #3ddcff;
  border-radius: 12px;
  box-shadow: 
    0 0 30px rgba(61,220,255,0.3),
    0 0 60px rgba(255,100,200,0.15),
    inset 0 1px 0 rgba(61,220,255,0.2);
  text-align: center;
  position: relative;
  animation: fadeIn 0.5s ease forwards;
  backdrop-filter: blur(16px);
}

.intro-window::before {
  content: '';
  position: absolute;
  top: 0; left: 0;
  width: 100%; height: 100%;
  background: linear-gradient(135deg, rgba(61,220,255,0.05), transparent);
  border-radius: 12px;
  pointer-events: none;
}

.intro-title {
  margin: 0 0 8px 0;
  font-family: 'Playfair Display', serif;
  font-weight: 900;
  font-size: 2.2em;
  letter-spacing: 3px;
  text-transform: uppercase;
  color: #3ddcff;
  animation: glow 3s ease infinite;
  position: relative;
  z-index: 1;
}

.intro-subtitle {
  font-size: 11px;
  color: var(--text-muted);
  margin-bottom: 24px;
  letter-spacing: 4px;
  text-transform: uppercase;
  font-weight: 600;
}

.intro-text {
  margin-bottom: 28px;
  line-height: 1.7;
  color: var(--text-secondary);
  font-size: 0.95em;
  position: relative;
  z-index: 1;
}

.intro-btn {
  background: linear-gradient(135deg, #3ddcff, #00a8e8);
  border: none;
  padding: 12px 36px;
  color: #000;
  font-family: 'Outfit', sans-serif;
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 2px;
  text-transform: uppercase;
  cursor: pointer;
  border-radius: 6px;
  transition: all 0.3s ease;
  position: relative;
  z-index: 1;
  box-shadow: 0 0 20px rgba(61,220,255,0.4);
}

.intro-btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 0 30px rgba(61,220,255,0.6), 0 8px 20px rgba(61,220,255,0.3);
}

/* ─────────────────────────────────────────────────────────────────────────
   CABEÇALHO DO SITE
   ───────────────────────────────────────────────────────────────────────── */
.site-header-container {
  width: 100%;
  display: flex;
  justify-content: center;
  padding: 32px 16px 20px;
  position: relative;
  z-index: 10;
}

.site-header-box {
  position: relative;
  max-width: 95%;
  width: 100%;
  background: linear-gradient(135deg, rgba(15,20,25,0.6), rgba(20,24,32,0.7));
  border: 2px solid #3ddcff;
  border-radius: 12px;
  overflow: hidden;
  backdrop-filter: blur(12px);
  box-shadow: 
    0 0 30px rgba(61,220,255,0.2),
    0 0 60px rgba(255,100,200,0.1),
    inset 0 1px 0 rgba(61,220,255,0.1);
}

.site-header-box::after {
  content: '';
  position: absolute;
  top: 0; left: -100%;
  width: 60%; height: 100%;
  background: linear-gradient(105deg, transparent 30%, rgba(61,220,255,0.1) 50%, transparent 70%);
  opacity: 0.4;
  animation: shimmer 6s ease-in-out infinite;
  pointer-events: none;
}

.site-header-accent-line {
  height: 2px;
  width: 100%;
  overflow: hidden;
}

.site-header-accent-line.top {
  background: linear-gradient(90deg, #3ddcff 0%, #ff64c8 40%, #d946ef 70%, transparent 100%);
  animation: shimmer 6s ease forwards;
}

.site-header-accent-line.bottom {
  background: linear-gradient(90deg, transparent 0%, #d946ef 30%, #ff64c8 60%, #3ddcff 100%);
  animation: shimmer 6s ease forwards;
}

.site-header-inner {
  padding: 24px 48px 22px;
  text-align: left;
  position: relative;
  z-index: 1;
}

.site-title {
  margin: 0;
  font-family: 'Playfair Display', serif;
  font-weight: 900;
  font-size: clamp(2.4rem, 7vw, 3.8rem);
  letter-spacing: 4px;
  text-transform: uppercase;
  color: var(--text-primary);
  line-height: 1;
  animation: slideIn 0.8s ease forwards;
  opacity: 0;
  animation-delay: 0.1s;
  text-shadow: 0 0 20px rgba(61,220,255,0.2);
}

.site-header-divider {
  width: 48px;
  height: 3px;
  background: linear-gradient(90deg, #3ddcff, #ff64c8);
  margin: 12px 0 8px;
  animation: slideIn 0.8s ease forwards;
  animation-delay: 0.2s;
  border-radius: 2px;
}

.site-subtitle {
  margin: 0;
  font-family: 'Outfit', sans-serif;
  font-size: 0.78em;
  font-weight: 600;
  letter-spacing: 3px;
  text-transform: uppercase;
  color: #ff64c8;
  animation: slideIn 0.8s ease forwards;
  animation-delay: 0.3s;
  opacity: 0;
}

.site-tag {
  margin: 8px 0 0;
  font-family: 'Space Mono', monospace;
  font-size: 0.7em;
  font-weight: 600;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: #3ddcff;
  animation: slideIn 0.8s ease forwards;
  animation-delay: 0.4s;
  opacity: 0;
}

/* ─────────────────────────────────────────────────────────────────────────
   CLASSES UTILITÁRIAS
   ───────────────────────────────────────────────────────────────────────── */
.ix-box {
  border: 1px solid var(--border-subtle);
  background: var(--bg-panel);
  padding: 15px;
  margin-bottom: 20px;
  border-radius: 6px;
}

.ix-box.a   { border-left: 4px solid #3ddcff; }
.ix-box.b   { border-left: 4px solid #ff64c8; }
.ix-box.c   { border-left: 4px solid #d946ef; }
.ix-box.alt { border-left: 4px solid #ff3366; }

.ix-h {
  margin-top: 0;
  text-transform: uppercase;
  letter-spacing: 2px;
  font-family: 'Outfit', sans-serif;
  font-weight: 700;
  font-size: 0.96em;
  color: #3ddcff;
}

.ix-h.ha   { color: #3ddcff; }
.ix-h.hb   { color: #ff64c8; }
.ix-h.halt { color: #ff3366; }
.ix-h.hac  { color: #d946ef; }

.ix-t  { color: var(--text-secondary); font-size: 0.96em; line-height: 1.5; }
.ix-tm { color: var(--text-muted); font-size: 0.91em; }
.ix-td { color: var(--text-dim); font-size: 0.91em; }
.ix-s  { color: #ff64c8; }

.ix-callout {
  margin-top: 12px;
  padding: 12px;
  background: var(--bg-inset);
  border-left: 3px solid #3ddcff;
  border-radius: 4px;
}

.ix-callout.b { border-left-color: #ff64c8; }
.ix-callout.c { border-left-color: #d946ef; }

.ix-banner {
  background: linear-gradient(135deg, #3ddcff, #00a8e8);
  padding: 14px;
  text-align: center;
  margin-bottom: 20px;
  border-left: 4px solid #ff64c8;
  color: #000;
  font-family: 'Outfit', sans-serif;
  font-weight: 900;
  font-size: 1.05em;
  letter-spacing: 2px;
  text-transform: uppercase;
  border-radius: 6px;
}

.ix-divider {
  border-top: 1px solid var(--border);
  padding-top: 10px;
  margin-top: 10px;
}

.ix-list-bordered {
  list-style-type: none;
  padding-left: 0;
}

.ix-list-bordered li {
  margin-bottom: 8px;
  padding-left: 15px;
  border-left: 2px solid #3ddcff;
  color: var(--text-muted);
  font-size: 0.91em;
}

</style>

<!-- SCRIPT DE CONTROLE DO MODAL -->
<script>
(function() {
  const modal = document.getElementById('introModal');
  const acceptBtn = document.getElementById('introAccept');
  
  if (!localStorage.getItem('criabyViniIntroAccepted')) {
    modal.style.display = 'flex';
  }
  
  acceptBtn.addEventListener('click', function() {
    localStorage.setItem('criabyViniIntroAccepted', 'true');
    modal.style.display = 'none';
  });
  
  // Fechar ao clicar fora
  modal.addEventListener('click', function(e) {
    if (e.target === modal) {
      modal.style.display = 'none';
    }
  });
})();
</script>

</body>